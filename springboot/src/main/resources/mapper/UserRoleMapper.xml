    <select id="findByUserIdAndType" resultType="com.example.entity.Role">
        SELECT r.*
        FROM `role` r
                 INNER JOIN `user_role` ur ON r.id = ur.role_id
        WHERE ur.user_id = #{userId} AND ur.user_type = #{userType}
    </select>

<!--验证判断-->
    <select id="existsByRoleId" resultType="java.lang.Boolean">
        SELECT EXISTS(SELECT 1 FROM `user_role` WHERE role_id = #{roleId})
    </select>

