<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.mapper.UserRoleMapper">

    <resultMap id="BaseResultMap" type="com.example.entity.UserRole">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="user_type" property="userType"/>
        <result column="role_id" property="roleId"/>
    </resultMap>
    <insert id="insertList">
        INSERT INTO `user_role` (user_id, user_type, role_id)
        VALUES
        <foreach collection="userRoles" item="userRole" separator=",">
            (#{userRole.userId}, #{userRole.userType}, #{userRole.roleId})
        </foreach>
    </insert>
    <delete id="deleteBatch">
        DELETE FROM `user_role` WHERE id IN
        <foreach collection="ids" item="id" open="(" close=")" separator=",">
            #{id}
        </foreach>
    </delete>
     <update id="updateById">
        UPDATE `user_role`
        SET role_id = #{roleId}
        WHERE id = #{id}
    </update>

