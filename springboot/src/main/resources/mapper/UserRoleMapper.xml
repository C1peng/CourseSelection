    <select id="getAllUserInfo" resultType="com.example.entity.VO.UserRoleVO">
        SELECT
            COALESCE(ur.id, -s.id) as id,
            s.username as username,
            s.name as name,
            'STUDENT' as userType,
            COALESCE(r.role_name, '') as roleName
        FROM `student` s
        LEFT JOIN `user_role` ur ON s.id = ur.user_id AND ur.user_type = 'STUDENT'
        LEFT JOIN `role` r ON ur.role_id = r.id
        UNION ALL
        SELECT
            COALESCE(ur.id, -t.id) as id,
            t.username as username,
            t.name as name,
            'TEACHER' as userType,
            COALESCE(r.role_name, '') as roleName
        FROM `teacher` t
        LEFT JOIN `user_role` ur ON t.id = ur.user_id AND ur.user_type = 'TEACHER'
        LEFT JOIN `role` r ON ur.role_id = r.id
    </select>
