<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.mapper.RoleMapper">

<!--    <resultMap id="BaseResultMap" type="com.example.entity.Role">-->
<!--        <id column="id" property="id"/>-->
<!--        <result column="role_code" property="roleCode"/>-->
<!--        <result column="role_name" property="roleName"/>-->
<!--    </resultMap>-->
    
    <!-- 查询所有角色 -->
    <select id="selectAll" resultType="com.example.entity.VO.RoleVO">
        SELECT * FROM `role`
            ORDER BY id
    </select>
    
    <!-- 新增角色 -->
    <insert id="insert" parameterType="com.example.entity.Role" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO `role` (role_code, role_name)
        VALUES (#{roleCode}, #{roleName})
    </insert>
    
    <!-- 更新角色 -->
    <update id="update" parameterType="com.example.entity.Role">
        UPDATE `role`
        SET role_code = #{roleCode},
            role_name = #{roleName}
        WHERE id = #{id}
    </update>
    
    <!-- 批量删除角色 -->
    <delete id="deleteById" parameterType="java.lang.Integer">
        DELETE FROM `role` WHERE id = #{id}
    </delete>
</mapper>